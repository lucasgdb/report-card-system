{
  "name": "usefaz",
  "description": "Sistema de Boletim do P.I. da Fatec Guaratinguetá",
  "private": true,
  "version": "1.0.0",
  "license": "ISC",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "docker compose up -d",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "restart": "docker compose restart",
    "start:server": "pnpm --filter @usefaz/server dev",
    "start:boletim": "pnpm --filter @usefaz/boletim dev",
    "start:admin": "pnpm --filter @usefaz/admin dev",
    "seed": "docker compose exec server pnpm seed",
    "relay": "pnpm --filter \"./apps/*\" --if-present relay",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",

    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "find . \\( -name node_modules -o -name build -o -name __generated__ \\) -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
