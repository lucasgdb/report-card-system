NODE_ENV=DEVELOPMENT

DB_HOST=database
DB_USER=usefaz_user
DB_PASSWORD=usefaz_password
DB_DATABASE=usefaz_database

BASE_URL=http://localhost:3000
BOLETIM_WEB_URL=http://localhost:8080
ADMIN_WEB_URL=http://localhost:8081
PORT=3000


RECAPTCHA_V3_SECRET_TOKEN=RECAPTCHA_V3_SECRET_TOKEN

# "smtp" (Gmail) or "log" (only writes e-mails to the log, for local testing).
MAIL_DRIVER=smtp
USEFAZ_EMAIL=USEFAZ_EMAIL
USEFAZ_EMAIL_PASSWORD=USEFAZ_EMAIL_PASSWORD

# Avatars: "local" (this server's public/ folder) or "s3" (set the S3_* variables).
STORAGE_DRIVER=local

# Session cookie: set COOKIE_SECURE=true in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
