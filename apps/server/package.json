{
  "name": "@usefaz/server",
  "description": "API GraphQL do Sistema de Boletim e Administrador Usefaz",
  "private": true,
  "version": "1.0.0",
  "license": "ISC",
  "scripts": {
    "dev": "pnpm migrate && tsx watch --env-file-if-exists=.env --inspect=0.0.0.0 --clear-screen=false src/index.ts",
    "start": "pnpm migrate && node --env-file-if-exists=.env build/index.cjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "knex": "tsx --env-file-if-exists=.env ./node_modules/knex/bin/cli.js",
    "migrate": "pnpm knex migrate:latest",
    "migrate:make": "pnpm knex migrate:make",
    "seed": "pnpm knex seed:run",
    "seed:make": "pnpm knex seed:make",
    "rollback": "pnpm knex migrate:down",
    "rollback:all": "pnpm knex migrate:rollback --all"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@usefaz/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "dayjs": "catalog:",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.1",
    "graphql-relay": "^0.11.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "koa": "^3.2.1",
    "koa-body": "^8.0.1",
    "koa-compress": "^5.2.2",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "nodemailer": "~10.2.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.3",
    "@types/koa-compress": "^4.0.7",
    "@types/koa-mount": "^4.0.5",
    "@types/koa-static": "^4.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "tsdown": "~0.23.3",
    "typescript": "catalog:"
  }
}
