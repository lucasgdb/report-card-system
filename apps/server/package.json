{
  "name": "@usefaz/server",
  "description": "API GraphQL do Sistema de Boletim e Administrador Usefaz",
  "private": true,
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm migrate && node --watch --env-file-if-exists=.env --inspect=0.0.0.0 src/index.ts",
    "start": "node --env-file-if-exists=.env build/migrate.mjs latest && node --env-file-if-exists=.env build/index.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env src/database/migrate.ts latest",
    "rollback": "node --env-file-if-exists=.env src/database/migrate.ts down",
    "seed": "node --env-file-if-exists=.env src/database/seed.ts",
    "db:types": "sh -c 'DATABASE_URL=postgres://$DB_USER:$DB_PASSWORD@$DB_HOST:${DB_PORT:-5432}/$DB_DATABASE kysely-codegen --dialect postgres --numeric-parser number --exclude-pattern \"(kysely_*|schema_version*)\" --out-file src/database/types.ts'",
    "db:reset": "node --env-file-if-exists=.env src/database/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@graphql-yoga/plugin-persisted-operations": "^4.0.1",
    "@hono/node-server": "~2.1.5",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-dataloader": "^4.5.0",
    "@pothos/plugin-relay": "^4.8.1",
    "@usefaz/shared": "workspace:*",
    "csv-parse": "^7.0.3",
    "dataloader": "^2.2.3",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "hono": "^4.13.16",
    "kysely": "^0.29.8",
    "nodemailer": "~10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "~0.23.3",
    "typescript": "catalog:"
  }
}
