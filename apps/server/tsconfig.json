{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "lib": ["ESNext"],
    // Node runs these sources as they are (type stripping): only erasable TypeScript syntax.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tsdown.config.ts"]
}
